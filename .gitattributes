# Text files are stored with LF; checked out as-is. Windows launchers keep CRLF so cmd.exe reads them cleanly.
* text=auto eol=lf
*.bat text eol=crlf
*.ini text eol=crlf
*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.xlsx binary
*.png binary
*.jpg binary
*.pdf binary
*.npz binary
